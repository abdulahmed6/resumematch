# Copy to .env for local development. All settings are prefixed RM_.

RM_ENV=dev
RM_DATABASE_URL=sqlite:///./resumematch.db
RM_REDIS_URL=redis://localhost:6379/0
RM_CELERY_EAGER=true            # false in production (real Celery workers)
RM_EMBEDDING_URL=               # empty = in-process embedder; set http://localhost:8001 for microservice mode
RM_EMBEDDER_BACKEND=hashing     # hashing | sentence-transformers
RM_EMBEDDING_DIM=384
RM_FAISS_INDEX_PATH=./data/faiss.index
RM_SCRAPE_BATCH_SIZE=350
RM_SCRAPE_INTERVAL_MINUTES=60
RM_CORS_ORIGINS=*
